<div class="row g-4">
  <!-- 左側カラム: メンバー一覧 -->
  <div class="col-lg-7 col-md-12">
    <div class="d-flex justify-content-between align-items-baseline mb-3">
      <h3 class="fw-bold mb-0 text-dark">メンバー一覧</h3>
      <span class="fs-5 text-muted fw-bold">
        登録選手：<span class="text-dark"><%= @players.count %></span>名
      </span>
    </div>

    <!-- 選手カードリスト -->
    <div class="d-flex flex-column gap-3">
      <% if @players.present? %>
        <% @players.each do |player| %>
          <div class="card border-0 shadow-sm rounded-3" style="background-color: #e9ecef;">
            <div class="card-body p-3 d-flex align-items-center justify-content-between">
              <!-- 左側: アイコン + 選手情報 -->
              <div class="d-flex align-items-center">
                <!-- 写真またはデフォルトアイコン -->
                <div class="me-3 text-white rounded d-flex align-items-center justify-content-center shadow-sm" 
                     style="width: 52px; height: 52px; background-color: #343a40; min-width: 52px;">
                  <% if player.image.attached? %>
                    <%= image_tag player.image, class: "w-100 h-100 rounded object-fit-cover" %>
                  <% else %>
                    <i class="bi bi-people-fill fs-3"></i>
                  <% end %>
                </div>

                <!-- 選手スペック -->
                <div>
                  <div class="d-flex align-items-center gap-2 mb-1">
                    <span class="fw-bold fs-5 text-dark">#<%= player.number.presence || "-" %></span>
                    <span class="fw-bold fs-5 text-dark"><%= player.name %></span>
                    <span class="badge bg-secondary ms-1"><%= player.position.presence || "未定" %></span>
                  </div>
                  <!-- 通算成績 -->
                  <div class="text-secondary small fw-bold">
                    <span><i class="bi bi-bullseye text-danger"></i> <%= player.goals_count %> ゴール</span>
                    <span class="ms-2"><i class="bi bi-arrow-up-right-circle text-primary"></i> <%= player.assists_count %> アシスト</span>
                  </div>
                </div>
              </div>

              <!-- 右側: アクションボタン -->
              <div>
                <%= link_to edit_player_path(player), class: "btn btn-primary px-3 shadow-sm rounded-2 fw-bold" do %>
                  編集
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% else %>
        <div class="card border-0 bg-white shadow-sm p-4 text-center text-muted">
          登録されている選手がまだいません。右側のフォームから追加してください。
        </div>
      <% end %>
    </div>
  </div>

  <!-- 右側カラム: メンバー登録フォーム -->
  <div class="col-lg-5 col-md-12">
    <div class="card border-0 shadow-sm rounded-3 p-4 bg-white sticky-top" style="top: 80px;">
      <h4 class="fw-bold text-center mb-4 text-dark">メンバー登録</h4>

      <%= form_with(model: @player, local: true, multipart: true) do |f| %>
        <!-- 名前 -->
        <div class="mb-3">
          <%= f.label :name, "名前", class: "form-label fw-bold" %>
          <%= f.text_field :name, class: "form-control form-control-lg bg-light border-1", placeholder: "例: 松戸 太郎", required: true %>
        </div>

        <!-- 背番号 -->
        <div class="mb-3">
          <%= f.label :number, "背番号", class: "form-label fw-bold" %>
          <%= f.number_field :number, class: "form-control form-control-lg bg-light border-1", placeholder: "例: 10", min: 0, max: 99 %>
        </div>

        <!-- ポジション -->
        <div class="mb-3">
          <%= f.label :position, "ポジション", class: "form-label fw-bold" %>
          <%= f.select :position, 
              Player.positions.keys, 
              { prompt: "ポジションを選択" }, 
              { class: "form-select form-select-lg bg-light border-1" } %>
        </div>

        <!-- 写真（任意） -->
        <div class="mb-4">
          <%= f.label :image, "写真（任意）", class: "form-label fw-bold" %>
          <%= f.file_field :image, class: "form-control bg-light", accept: "image/*" %>
          <div class="form-text text-muted">※スマホの写真やアイコン画像</div>
        </div>

        <!-- 保存ボタン（ワイヤーフレームの鮮やかなグリーン） -->
        <div class="text-center mt-4">
          <%= f.submit "保存", class: "btn btn-lg w-50 text-white fw-bold shadow-sm", style: "background-color: #51cf66;" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
