<div class="container py-4">
  <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
    <h3 class="fw-bold mb-4 text-dark">試合の記録</h3>

    <%= form_with(model: @match, local: true) do |f| %>
      <div class="row g-5">
        <!-- 左半分: 基本情報（日時・対戦相手） -->
        <div class="col-md-6">
          <!-- 試合日 -->
          <div class="mb-4">
            <%= f.label :match_date, "試合日", class: "form-label fw-bold fs-5 text-dark" %>
            <%= f.date_field :match_date, class: "form-control form-control-lg bg-light border-1", value: Date.current, required: true %>
          </div>

          <!-- kick off時間 -->
          <div class="mb-4">
            <%= f.label :kickoff_time, "kick off時間", class: "form-label fw-bold fs-5 text-dark" %>
            <%= f.time_field :kickoff_time, class: "form-control form-control-lg bg-light border-1", required: true %>
          </div>

          <!-- 対戦相手 -->
          <div class="mb-4">
            <%= f.label :opponent_id, "対戦相手", class: "form-label fw-bold fs-5 text-dark" %>
            <%= f.collection_select :opponent_id, @opponents, :id, :name, 
                { prompt: "選択してください" }, 
                { class: "form-select form-select-lg bg-light border-1 mb-2", required: true } %>
            
            <%= link_to new_opponent_path, class: "btn btn-outline-secondary btn-sm rounded" do %>
              新規チームを追加
            <% end %>
          </div>
        </div>

        <!-- 右半分: スコア入力（MCFC vs 相手チーム） -->
        <div class="col-md-6">
          <h4 class="fw-bold text-center mb-4 text-dark">スコア入力</h4>

          <div class="row text-center mb-3">
            <div class="col-6">
              <span class="fw-bold fs-5 text-dark">MCFC</span>
            </div>
            <div class="col-6">
              <span class="fw-bold fs-5 text-dark">相手チーム</span>
            </div>
          </div>

          <!-- 前半スコア -->
          <div class="row align-items-center mb-3">
            <div class="col-6 d-flex align-items-center justify-content-center gap-2">
              <span class="fw-bold text-muted">前半：</span>
              <%= f.number_field :our_first_half, class: "form-control text-center fs-5 bg-light border-1", style: "width: 70px;", min: 0, placeholder: "0" %>
            </div>
            <div class="col-6 d-flex align-items-center justify-content-center gap-2">
              <span class="fw-bold text-muted">前半：</span>
              <%= f.number_field :opp_first_half, class: "form-control text-center fs-5 bg-light border-1", style: "width: 70px;", min: 0, placeholder: "0" %>
            </div>
          </div>

          <!-- 後半スコア -->
          <div class="row align-items-center mb-4">
            <div class="col-6 d-flex align-items-center justify-content-center gap-2">
              <span class="fw-bold text-muted">後半：</span>
              <%= f.number_field :our_second_half, class: "form-control text-center fs-5 bg-light border-1", style: "width: 70px;", min: 0, placeholder: "0" %>
            </div>
            <div class="col-6 d-flex align-items-center justify-content-center gap-2">
              <span class="fw-bold text-muted">後半：</span>
              <%= f.number_field :opp_second_half, class: "form-control text-center fs-5 bg-light border-1", style: "width: 70px;", min: 0, placeholder: "0" %>
            </div>
          </div>

          <!-- 保存ボタン（ワイヤーフレームのグリーン） -->
          <div class="text-center mt-5">
            <%= f.submit "保存", class: "btn btn-lg px-5 text-white fw-bold shadow-sm", style: "background-color: #51cf66;" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
