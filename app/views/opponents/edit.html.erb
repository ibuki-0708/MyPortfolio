<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
      <!-- 戻る導線 -->
      <div class="mb-3">
        <%= link_to opponents_path, class: "text-decoration-none text-muted small fw-bold" do %>
          <i class="bi bi-arrow-left me-1"></i>対戦チーム一覧へ戻る
        <% end %>
      </div>

      <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <h4 class="fw-bold text-center mb-4 text-dark">対戦チームの編集</h4>

        <%= form_with(model: @opponent, local: true) do |f| %>
          <!-- チーム名 -->
          <div class="mb-4">
            <%= f.label :name, "チーム名", class: "form-label fw-bold" %>
            <%= f.text_field :name, class: "form-control form-control-lg bg-light border-1", required: true %>
          </div>

          <!-- チームロゴ・写真 -->
          <div class="mb-4">
            <%= f.label :image, "チームエンブレム・写真（任意）", class: "form-label fw-bold" %>
            
            <!-- 現在登録されているロゴのプレビュー -->
            <% if @opponent.image.attached? %>
              <div class="d-flex align-items-center gap-3 mb-2 p-2 rounded bg-light border">
                <%= image_tag @opponent.image, class: "rounded-circle object-fit-cover shadow-sm bg-white", style: "width: 48px; height: 48px;" %>
                <div class="small text-muted">
                  現在の登録エンブレム<br>
                  変更する場合は新しい画像ファイルを選択してください
                </div>
              </div>
            <% end %>

            <%= f.file_field :image, class: "form-control bg-light", accept: "image/*" %>
          </div>

          <!-- 更新ボタン -->
          <div class="text-center mt-4">
            <%= f.submit "更新する", class: "btn btn-lg w-50 text-white fw-bold shadow-sm", style: "background-color: #51cf66;" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>