<div class="container py-4">
  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
      <div class="mb-3">
        <%= link_to new_match_path, class: "text-decoration-none text-muted small fw-bold" do %>
          <i class="bi bi-arrow-left me-1"></i>試合記録画面へ戻る
        <% end %>
      </div>

      <div class="card border-0 shadow-sm rounded-3 p-4 bg-white">
        <h4 class="fw-bold text-center mb-4 text-dark">対戦チームの登録</h4>

        <%= form_with(model: @opponent, local: true) do |f| %>
          <!-- チーム名 -->
          <div class="mb-3">
            <%= f.label :name, "チーム名", class: "form-label fw-bold" %>
            <%= f.text_field :name, class: "form-control form-control-lg bg-light border-1", placeholder: "例: FC柏", required: true %>
          </div>

          <!-- チームロゴ・写真（任意） -->
          <div class="mb-4">
            <%= f.label :image, "チームエンブレム・写真（任意）", class: "form-label fw-bold" %>
            <%= f.file_field :image, class: "form-control bg-light", accept: "image/*" %>
          </div>

          <!-- 保存ボタン -->
          <div class="text-center mt-4">
            <%= f.submit "登録する", class: "btn btn-lg w-50 text-white fw-bold shadow-sm", style: "background-color: #51cf66;" %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>