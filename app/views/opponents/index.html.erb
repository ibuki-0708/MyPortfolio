<div class="container py-4">
  <!-- ページ見出し & 新規登録ボタン -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="fw-bold mb-0 text-dark">対戦チーム一覧</h3>
  </div>

  <!-- 対戦チームカード一覧 -->
  <div class="d-flex flex-column gap-3">
    <% if @opponents.present? %>
      <% @opponents.each do |opponent| %>
        <div class="card border-0 shadow-sm rounded-3" style="background-color: #dcdcdc;">
          <div class="card-body p-4 position-relative">
            
            <!-- 上段: チームアイコン・チーム名 & 右上ボタン（編集・削除） -->
            <div class="d-flex justify-content-between align-items-start mb-3">
              <div class="d-flex align-items-center gap-2">
                <% if opponent.respond_to?(:image) && opponent.image.attached? %>
                  <%= image_tag opponent.image, class: "rounded-circle bg-white shadow-sm flex-shrink-0 object-fit-cover", style: "width: 44px; height: 44px; min-width: 44px;" %>
                <% else %>
                  <div class="rounded-circle bg-white border d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style="width: 44px; height: 44px; min-width: 44px;">
                    <span class="fs-5">⚽</span>
                  </div>
                <% end %>
                <h4 class="fw-bold text-dark mb-0 ms-1"><%= opponent.name %></h4>
              </div>

              <!-- 右上: 編集・削除ボタン -->
              <div class="d-flex gap-2">
                <%= link_to edit_opponent_path(opponent), class: "btn btn-primary btn-sm px-3 fw-bold rounded shadow-sm" do %>
                  編集
                <% end %>
              </div>
            </div>

            <!-- 中段: 通算戦績 (○試合 ○勝 ○敗 ○分) -->
            <div class="ps-5 mb-3">
              <span class="fs-5 fw-bold text-dark me-4"><%= opponent.total_matches_count %>試合</span>
              <span class="fs-5 fw-bold text-dark me-4"><%= opponent.wins_count %>勝</span>
              <span class="fs-5 fw-bold text-dark me-4"><%= opponent.losses_count %>敗</span>
              <span class="fs-5 fw-bold text-dark"><%= opponent.draws_count %>分</span>
            </div>

            <!-- 下段: 直近の試合結果 & 右下「対戦履歴」ボタン -->
            <div class="d-flex justify-content-between align-items-end ps-5">
              <div class="fs-5 fw-bold text-dark d-flex align-items-center gap-2">
                <span>直近：</span>
                <% if opponent.latest_match.present? %>
                  <% match = opponent.latest_match %>
                  <span><%= match.match_date&.strftime("%Y/%m/%d") %></span>
                  
                  <!-- 勝敗マーク -->
                  <% if match.won? %>
                    <span class="text-success fs-4">○</span>
                  <% elsif match.lost? %>
                    <span class="text-dark fs-4">●</span>
                  <% else %>
                    <span class="text-muted fs-4">△</span>
                  <% end %>
                  
                  <!-- 合計スコア -->
                  <span><%= match.our_total_score %> - <%= match.opp_total_score %></span>
                <% else %>
                  <span class="text-muted fs-6">対戦データなし</span>
                <% end %>
              </div>

              <!-- 右下: 対戦履歴リンク -->
              <div>
                <%= link_to opponent_path(opponent), class: "btn btn-info text-white fw-bold px-4 py-2 shadow-sm rounded", style: "background-color: #38a9f5; border: none;" do %>
                  対戦履歴
                <% end %>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    <% else %>
      <div class="card border-0 bg-white shadow-sm p-5 text-center text-muted rounded-3">
        <i class="bi bi-shield-x fs-1 d-block mb-2"></i>
        対戦相手チームがまだ登録されていません。<br>
        右上のボタンから追加してください。
      </div>
    <% end %>
  </div>
</div>
