<div class="container py-3 py-md-4">
  <!-- ページ見出し & 新規登録ボタン -->
  <div class="d-flex justify-content-between align-items-center mb-3 mb-md-4">
    <h3 class="fw-bold mb-0 text-dark">対戦チーム一覧</h3>
  </div>

  <!-- 対戦チームカード一覧 -->
  <div class="d-flex flex-column gap-3">
    <% if @opponents.present? %>
      <% @opponents.each do |opponent| %>
        <div class="card border-0 shadow-sm rounded-3" style="background-color: #dcdcdc;">
          <div class="card-body p-3 p-md-4">
            
            <!-- 上段: チームアイコン・チーム名 & 右上ボタン（編集・削除） -->
            <div class="d-flex justify-content-between align-items-center mb-2">
              <div class="d-flex align-items-center gap-2 overflow-hidden">
                <% if opponent.image.attached? %>
                  <%= image_tag opponent.image, class: "rounded-circle bg-white shadow-sm flex-shrink-0 object-fit-cover", style: "width: 38px; height: 38px; min-width: 38px;" %>
                <% else %>
                  <div class="rounded-circle bg-white border d-flex align-items-center justify-content-center shadow-sm flex-shrink-0" style: "width: 38px; height: 38px; min-width: 38px;">
                    <span class="fs-5">⚽</span>
                  </div>
                <% end %>
                <h4 class="fw-bold text-dark mb-0 text-truncate"><%= opponent.name %></h4>
              </div>

              <!-- 右上: 編集・削除ボタン -->
              <div class="flex-shrink-0 ms-2">
                <%= link_to "編集", edit_opponent_path(opponent), class: "btn btn-primary btn-sm px-3 fw-bold rounded shadow-sm" %>
              </div>
            </div>

            <!-- 中段: 通算戦績 (○試合 ○勝 ○敗 ○分) -->
            <div class="d-flex gap-2 gap-md-4 mb-2 ps-1 text-nowrap fs-6 fw-bold text-dark">
              <span><%= opponent.total_matches_count %>試合</span>
              <span><%= opponent.wins_count %>勝</span>
              <span><%= opponent.losses_count %>敗</span>
              <span><%= opponent.draws_count %>分</span>
            </div>

            <!-- 下段: 直近の試合結果 & 右下「対戦履歴」ボタン -->
            <div class="d-flex justify-content-between align-items-center pt-2 border-top border-secondary-subtle">
              <!-- 直近スコア（text-nowrapで絶対に縦崩れさせない） -->
              <div class="text-nowrap fw-bold text-dark small">
                <span class="text-muted">直近：</span>
                <% if opponent.latest_match.present? %>
                  <% match = opponent.latest_match %>
                  <span class="ms-1"><%= match.match_date&.strftime("%Y/%m/%d") %></span>
                  
                  <!-- 勝敗マーク -->
                  <% if match.won? %>
                    <span class="text-success ms-1">○</span>
                  <% elsif match.lost? %>
                    <span class="text-dark ms-1">●</span>
                  <% else %>
                    <span class="text-muted ms-1">△</span>
                  <% end %>
                  
                  <!-- 合計スコア -->
                  <span class="ms-1 fs-6"><%= match.our_total_score %> - <%= match.opp_total_score %></span>
                <% else %>
                  <span class="text-muted ms-1">対戦データなし</span>
                <% end %>
              </div>

              <!-- 右下: 対戦履歴リンク -->
              <div class="flex-shrink-0 ms-2">
                <%= link_to opponent_path(opponent), class: "btn btn-info btn-sm text-white fw-bold px-3 py-1 shadow-sm rounded text-nowrap", style: "background-color: #38a9f5; border: none;" do %>
                  対戦履歴
                <% end %>
              </div>
            </div>

          </div>
        </div>
      <% end %>
    <% else %>
      <div class="card border-0 bg-white shadow-sm p-4 text-center text-muted rounded-3">
        対戦相手チームがまだ登録されていません。<br>
        右上のボタンから追加してください。
      </div>
    <% end %>
  </div>
</div>
